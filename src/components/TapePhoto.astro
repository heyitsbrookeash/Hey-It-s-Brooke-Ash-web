---
export type Props = {
  src: string;
  alt: string;
  caption: string;
  tilt?: 1 | 2 | 3 | 4;
  tapeColor?: "sage" | "burnt";
};

const { src, alt, caption, tilt = 1, tapeColor = "sage" } = Astro.props;
---

<figure class={`tape-photo tilt-${tilt}`}>
  <span class={`tape ${tapeColor === "burnt" ? "tape-burnt" : ""}`}></span>
  <img src={src} alt={alt} loading="lazy" />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .tape-photo {
    position: relative;
    flex: none;
    width: 220px;
    background: var(--paper);
    border: 1.5px solid var(--charcoal);
    padding: 0.5rem 0.5rem 1rem;
    margin: 0;
    scroll-snap-align: start;
  }

  .tape-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .tape-photo figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
    text-align: center;
    color: var(--charcoal);
  }
</style>
