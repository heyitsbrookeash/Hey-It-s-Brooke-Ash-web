---
import { primaryNav } from "../lib/nav";
import MenuOverlay from "./MenuOverlay.astro";

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-row">
    <button
      type="button"
      class="menu-badge"
      id="menu-open-btn"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="site-menu-overlay"
    >
      <span class="menu-badge-lines" aria-hidden="true"></span>
      <span class="menu-badge-label">Menu</span>
    </button>

    <a href="/" class="wordmark">
      Hey It's <em>Brooke Ash</em>
    </a>

    <span class="header-spacer" aria-hidden="true"></span>
  </div>

  <nav class="primary-nav" aria-label="Primary">
    <ul>
      {
        primaryNav.map((link, i) => (
          <>
            {i > 0 && (
              <li class="nav-dot-wrap" aria-hidden="true">
                <span class="nav-dot" />
              </li>
            )}
            <li>
              <a href={link.href} aria-current={path.startsWith(link.href) && link.href !== "/" ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          </>
        ))
      }
    </ul>
  </nav>
</header>

<MenuOverlay />

<style>
  .site-header {
    padding-block: 1.5rem 1rem;
    position: relative;
    z-index: 10;
  }

  .header-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .header-spacer {
    width: 44px;
  }

  .wordmark {
    justify-self: center;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--charcoal);
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
  }

  .wordmark em {
    color: var(--burnt-deep);
  }

  .menu-badge {
    justify-self: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px dashed var(--charcoal);
    background: var(--paper);
    color: var(--charcoal);
    font-family: var(--font-sans);
    padding: 0;
  }

  .menu-badge-lines {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    box-shadow: 0 5px 0 currentColor, 0 -5px 0 currentColor;
  }

  .menu-badge-label {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: none;
  }

  .primary-nav {
    margin-top: 1.1rem;
    display: flex;
    justify-content: center;
  }

  .primary-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
  }

  .primary-nav a {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }

  .primary-nav a:hover,
  .primary-nav a[aria-current="page"] {
    border-color: var(--burnt-deep);
    color: var(--burnt-deep);
  }

  .nav-dot-wrap {
    display: flex;
    color: var(--charcoal);
  }

  @media (max-width: 640px) {
    .primary-nav ul {
      gap: 0.6rem;
    }
    .primary-nav a {
      font-size: 0.76rem;
    }
    .wordmark {
      font-size: 1.15rem;
    }
  }
</style>

<script>
  const openBtn = document.getElementById("menu-open-btn");
  const overlay = document.getElementById("site-menu-overlay");

  if (openBtn && overlay) {
    openBtn.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("brooke:menu-open", { detail: { trigger: openBtn } }));
    });
  }
</script>
