---
export type Props = {
  kind: "compass" | "heart" | "starburst" | "airplane";
  class?: string;
  rotate?: number;
  size?: number;
};

const { kind, class: className = "", rotate = -6, size = 84 } = Astro.props;
---

<svg
  class={`sticker ${className}`}
  width={size}
  height={size}
  viewBox="0 0 84 84"
  aria-hidden="true"
  style={`transform: rotate(${rotate}deg);`}
>
  {
    kind === "compass" && (
      <g>
        <circle cx="42" cy="42" r="38" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.5" />
        <circle cx="42" cy="42" r="30" fill="none" stroke="var(--sage-deep)" stroke-width="1" />
        <path d="M42 14 L48 42 L42 70 L36 42 Z" fill="var(--burnt)" stroke="var(--charcoal)" stroke-width="1" />
        <path d="M14 42 L42 36 L70 42 L42 48 Z" fill="var(--sage)" stroke="var(--charcoal)" stroke-width="1" />
        <circle cx="42" cy="42" r="3" fill="var(--charcoal)" />
        <text x="42" y="12" text-anchor="middle" font-family="Inter, sans-serif" font-size="7" font-weight="700" fill="var(--charcoal)">N</text>
      </g>
    )
  }
  {
    kind === "heart" && (
      <g>
        <circle cx="42" cy="42" r="38" fill="var(--burnt)" stroke="var(--charcoal)" stroke-width="1.5" />
        <path
          d="M42 56 C24 44 20 32 30 26 C36 22.5 42 27 42 32 C42 27 48 22.5 54 26 C64 32 60 44 42 56 Z"
          fill="var(--paper)"
          stroke="var(--charcoal)"
          stroke-width="1"
        />
        <text x="42" y="70" text-anchor="middle" font-family="Cormorant Garamond, serif" font-style="italic" font-size="11" fill="var(--paper)">xoxo</text>
      </g>
    )
  }
  {
    kind === "starburst" && (
      <g>
        <path
          d="M42 4 L48 30 L72 20 L54 38 L80 42 L54 46 L72 64 L48 54 L42 80 L36 54 L12 64 L30 46 L4 42 L30 38 L12 20 L36 30 Z"
          fill="var(--sage)"
          stroke="var(--charcoal)"
          stroke-width="1.25"
        />
        <text x="42" y="46" text-anchor="middle" font-family="Inter, sans-serif" font-weight="700" font-size="8" fill="var(--charcoal)">
          <tspan x="42" dy="-4">reader</tspan>
          <tspan x="42" dy="10">favorite</tspan>
        </text>
      </g>
    )
  }
  {
    kind === "airplane" && (
      <g>
        <circle cx="42" cy="42" r="38" fill="var(--sage-deep)" stroke="var(--charcoal)" stroke-width="1.5" />
        <path
          d="M20 46 L62 26 L44 62 L38 46 L20 46Z"
          fill="var(--paper)"
          stroke="var(--charcoal)"
          stroke-width="1"
          stroke-linejoin="round"
        />
        <text x="42" y="72" text-anchor="middle" font-family="Cormorant Garamond, serif" font-style="italic" font-size="10" fill="var(--paper)">send it</text>
      </g>
    )
  }
</svg>
