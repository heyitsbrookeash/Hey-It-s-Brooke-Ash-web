---
export type Props = {
  kind: "compass" | "heart" | "starburst" | "airplane" | "coffee" | "passport" | "pin" | "camera" | "reel";
  class?: string;
  rotate?: number;
  size?: number;
};

const { kind, class: className = "", rotate = -6, size = 84 } = Astro.props;
---

<svg
  class={`sticker ${className}`}
  width={size}
  height={size}
  viewBox="0 0 84 84"
  aria-hidden="true"
  style={`transform: rotate(${rotate}deg);`}
>
  {
    kind === "compass" && (
      <g>
        <circle cx="42" cy="42" r="38" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.5" />
        <circle cx="42" cy="42" r="30" fill="none" stroke="var(--sage-deep)" stroke-width="1" />
        <path d="M42 14 L48 42 L42 70 L36 42 Z" fill="var(--burnt)" stroke="var(--charcoal)" stroke-width="1" />
        <path d="M14 42 L42 36 L70 42 L42 48 Z" fill="var(--sage)" stroke="var(--charcoal)" stroke-width="1" />
        <circle cx="42" cy="42" r="3" fill="var(--charcoal)" />
        <text x="42" y="12" text-anchor="middle" font-family="Inter, sans-serif" font-size="7" font-weight="700" fill="var(--charcoal)">N</text>
      </g>
    )
  }
  {
    kind === "heart" && (
      <g>
        <circle cx="42" cy="42" r="38" fill="var(--burnt)" stroke="var(--charcoal)" stroke-width="1.5" />
        <path
          d="M42 56 C24 44 20 32 30 26 C36 22.5 42 27 42 32 C42 27 48 22.5 54 26 C64 32 60 44 42 56 Z"
          fill="var(--paper)"
          stroke="var(--charcoal)"
          stroke-width="1"
        />
        <text x="42" y="70" text-anchor="middle" font-family="Cormorant Garamond, serif" font-style="italic" font-size="11" fill="var(--paper)">xoxo</text>
      </g>
    )
  }
  {
    kind === "starburst" && (
      <g>
        <path
          d="M42 4 L48 30 L72 20 L54 38 L80 42 L54 46 L72 64 L48 54 L42 80 L36 54 L12 64 L30 46 L4 42 L30 38 L12 20 L36 30 Z"
          fill="var(--sage)"
          stroke="var(--charcoal)"
          stroke-width="1.25"
        />
        <text x="42" y="46" text-anchor="middle" font-family="Inter, sans-serif" font-weight="700" font-size="8" fill="var(--charcoal)">
          <tspan x="42" dy="-4">reader</tspan>
          <tspan x="42" dy="10">favorite</tspan>
        </text>
      </g>
    )
  }
  {
    kind === "airplane" && (
      <g>
        <circle cx="42" cy="42" r="38" fill="var(--sage-deep)" stroke="var(--charcoal)" stroke-width="1.5" />
        <path
          d="M20 46 L62 26 L44 62 L38 46 L20 46Z"
          fill="var(--paper)"
          stroke="var(--charcoal)"
          stroke-width="1"
          stroke-linejoin="round"
        />
        <text x="42" y="72" text-anchor="middle" font-family="Cormorant Garamond, serif" font-style="italic" font-size="10" fill="var(--paper)">send it</text>
      </g>
    )
  }
  {
    kind === "coffee" && (
      <g>
        <circle cx="42" cy="42" r="38" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.5" />
        <path d="M28 34 C28 32 29 31 31 31 L51 31 C53 31 54 32 54 34 L52 60 C51.5 63 49 65 46 65 L36 65 C33 65 30.5 63 30 60 Z" fill="var(--burnt)" stroke="var(--charcoal)" stroke-width="1.25" />
        <path d="M54 38 C62 38 62 50 54 50" fill="none" stroke="var(--charcoal)" stroke-width="2" />
        <path d="M34 26 C32 22 36 20 34 16" fill="none" stroke="var(--sage-deep)" stroke-width="1.5" stroke-linecap="round" />
        <path d="M42 26 C40 22 44 20 42 16" fill="none" stroke="var(--sage-deep)" stroke-width="1.5" stroke-linecap="round" />
      </g>
    )
  }
  {
    kind === "passport" && (
      <g>
        <circle cx="42" cy="42" r="38" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.5" stroke-dasharray="3 3" />
        <circle cx="42" cy="42" r="29" fill="none" stroke="var(--burnt)" stroke-width="1.25" stroke-dasharray="2 3" />
        <path d="M25 44 L59 44 M31 36 L53 36 M31 52 L53 52" stroke="var(--sage-deep)" stroke-width="1.5" stroke-linecap="round" />
        <text x="42" y="24" text-anchor="middle" font-family="Inter, sans-serif" font-weight="700" font-size="7" letter-spacing="1" fill="var(--charcoal)">STAMPED</text>
      </g>
    )
  }
  {
    kind === "pin" && (
      <g>
        <circle cx="42" cy="42" r="38" fill="var(--sage)" stroke="var(--charcoal)" stroke-width="1.5" />
        <ellipse cx="43" cy="58" rx="6" ry="2" fill="var(--charcoal)" opacity="0.18" />
        <path d="M42 24 L42 52" stroke="var(--charcoal)" stroke-width="1.5" />
        <circle cx="42" cy="24" r="11" fill="var(--burnt)" stroke="var(--charcoal)" stroke-width="1.25" />
        <circle cx="38" cy="20" r="3" fill="var(--paper)" opacity="0.7" />
      </g>
    )
  }
  {
    kind === "camera" && (
      <g>
        <circle cx="42" cy="42" r="38" fill="var(--charcoal)" stroke="var(--charcoal)" stroke-width="1.5" />
        <rect x="20" y="32" width="44" height="30" rx="2" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.25" />
        <rect x="30" y="24" width="14" height="9" rx="1.5" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.25" />
        <circle cx="42" cy="47" r="10" fill="var(--sage)" stroke="var(--charcoal)" stroke-width="1.25" />
        <circle cx="42" cy="47" r="4.5" fill="var(--charcoal)" />
        <circle cx="55" cy="38" r="2" fill="var(--burnt)" />
      </g>
    )
  }
  {
    kind === "reel" && (
      <g>
        <circle cx="42" cy="42" r="38" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.5" />
        <circle cx="42" cy="42" r="26" fill="none" stroke="var(--charcoal)" stroke-width="1.5" />
        <circle cx="42" cy="42" r="6" fill="var(--burnt)" stroke="var(--charcoal)" stroke-width="1" />
        <circle cx="42" cy="20" r="5.5" fill="var(--sage)" stroke="var(--charcoal)" stroke-width="1" />
        <circle cx="61" cy="33" r="5.5" fill="var(--sage)" stroke="var(--charcoal)" stroke-width="1" />
        <circle cx="61" cy="53" r="5.5" fill="var(--sage)" stroke="var(--charcoal)" stroke-width="1" />
        <circle cx="42" cy="64" r="5.5" fill="var(--sage)" stroke="var(--charcoal)" stroke-width="1" />
        <circle cx="23" cy="53" r="5.5" fill="var(--sage)" stroke="var(--charcoal)" stroke-width="1" />
        <circle cx="23" cy="33" r="5.5" fill="var(--sage)" stroke="var(--charcoal)" stroke-width="1" />
      </g>
    )
  }
</svg>
