---
import BaseLayout from "../layouts/BaseLayout.astro";
import Polaroid from "../components/Polaroid.astro";
import Newsletter from "../components/Newsletter.astro";
import Sticker from "../components/Sticker.astro";

const facts = [
  { label: "Currently based in", value: "Seattle, WA" },
  { label: "Day job", value: "SDR, tech sales" },
  { label: "Moved here from", value: "Jacksonville, FL" },
  { label: "Order at any coffee shop", value: "Oat milk cortado, always" },
];
---

<BaseLayout
  title="About"
  description="The story behind Hey It's Brooke Ash: a sales day job, a solo move to Seattle, and a blog that became the creative outlet."
  page="about"
>
  <section class="section-sm about-hero">
    <div class="wrap about-hero-inner">
      <Sticker kind="heart" class="about-heart" rotate={9} size={72} />
      <span class="eyebrow"><span class="nav-dot"></span> About</span>
      <h1 class="section-title about-title">Hi, I'm Brooke.</h1>
      <p class="section-sub about-copy">
        By day I'm in sales, chasing quotas and cold-calling strangers. By evening and weekend, I'm here,
        writing about the city I talked myself into moving to alone and never quite got over.
      </p>
    </div>
  </section>

  <section class="section story">
    <div class="wrap story-grid">
      <Polaroid
        src="/images/about-story.svg"
        alt="Boxes in an empty Seattle apartment on move-in day"
        caption="day one, no furniture yet"
        tilt={2}
      />
      <div class="story-copy">
        <span class="eyebrow"><span class="nav-dot"></span> The short version</span>
        <h2 class="section-title">I moved to Seattle knowing exactly one person.</h2>
        <p>
          I'd never been west of Texas before I flew out for the interview. Three weeks later I packed a
          car and drove up anyway, mostly because staying in Jacksonville felt like a decision I'd already
          made by accident, and I wanted to make a different one on purpose.
        </p>
        <p>
          The blog started as a way to remember things, honestly. A restaurant I liked, a hike that kicked
          my butt, a coffee order I wanted to find again. It turned into this: a running, slightly chaotic
          scrapbook of a life I'm still very much building.
        </p>
      </div>
    </div>
  </section>

  <section class="section-sm journey">
    <div class="wrap journey-grid">
      <div class="journey-copy">
        <span class="eyebrow"><span class="nav-dot"></span> How I got here</span>
        <h2 class="section-title">The path, roughly</h2>
        <ol class="journey-steps">
          <li>
            <span class="step-num">01</span>
            <div>
              <h3>The day job, first</h3>
              <p>Landed the SDR role, said yes before I let myself overthink it.</p>
            </div>
          </li>
          <li>
            <span class="step-num">02</span>
            <div>
              <h3>The drive</h3>
              <p>Four days, one very full car, and a playlist I still can't listen to without getting emotional.</p>
            </div>
          </li>
          <li>
            <span class="step-num">03</span>
            <div>
              <h3>The blog</h3>
              <p>Started posting three months in, mostly so I'd remember what I'd actually done with the year.</p>
            </div>
          </li>
        </ol>
      </div>
      <Polaroid
        src="/images/about-journey.svg"
        alt="A car packed for a cross-country move"
        caption="the drive up, August of last year"
        tilt={3}
      />
    </div>
  </section>

  <section class="section-sm specifics">
    <div class="wrap">
      <span class="eyebrow"><span class="nav-dot"></span> A few specifics</span>
      <h2 class="section-title">Quick facts, for the record</h2>
      <dl class="facts-grid">
        {
          facts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<style>
  .about-hero-inner {
    position: relative;
    max-width: 640px;
    text-align: center;
    margin-inline: auto;
  }

  .about-hero-inner :global(.about-heart) {
    top: -1.25rem;
    right: -0.5rem;
  }

  @media (max-width: 640px) {
    .about-hero-inner :global(.about-heart) {
      display: none;
    }
  }

  .about-title {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
  }

  .about-copy {
    margin-inline: auto;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3rem;
    align-items: center;
  }

  .story-copy p {
    margin-top: 1.1rem;
    opacity: 0.85;
    line-height: 1.7;
  }

  .journey-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
  }

  .journey-steps {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .journey-steps li {
    display: flex;
    gap: 1.25rem;
  }

  .step-num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--burnt);
    flex: none;
  }

  .journey-steps h3 {
    font-size: 1.25rem;
  }

  .journey-steps p {
    margin-top: 0.4rem;
    opacity: 0.82;
  }

  .facts-grid {
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    background: var(--paper);
    border: 1px solid var(--charcoal);
    padding: 2rem;
  }

  .fact {
    padding: 0.5rem 0;
  }

  .fact dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sage-deep);
  }

  .fact dd {
    margin: 0.4rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--charcoal);
  }

  @media (max-width: 760px) {
    .story-grid,
    .journey-grid {
      grid-template-columns: 1fr;
    }
    .journey-grid {
      display: flex;
      flex-direction: column-reverse;
    }
    .facts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
