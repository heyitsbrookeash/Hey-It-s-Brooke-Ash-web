---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Newsletter from "../../components/Newsletter.astro";
import { getCollection } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("journal");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.excerpt} page="journal">
  <article class="post section-sm">
    <div class="wrap post-head">
      <a href="/journal" class="cta-link">Back to journal</a>
      <span class="tag" style="margin-top: 1.5rem;">
        {post.data.category}
        <span class="tag-dot"></span>
        {post.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
      </span>
      <h1 class="post-title">{post.data.title}</h1>
    </div>

    <div class="wrap post-image-wrap">
      <img src={post.data.image} alt={post.data.imageAlt} class="post-image" />
    </div>

    <div class="wrap post-body">
      <Content />
    </div>
  </article>

  <Newsletter />
</BaseLayout>

<style>
  .post-head {
    max-width: 68ch;
  }

  .post-title {
    margin-top: 1rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
  }

  .post-image-wrap {
    margin-top: 2.5rem;
  }

  .post-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--charcoal);
  }

  .post-body {
    max-width: 68ch;
    margin-top: 2.5rem;
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .post-body :global(p) {
    margin-bottom: 1.4rem;
  }

  .post-body :global(h2) {
    margin: 2.2rem 0 1rem;
    font-size: 1.6rem;
  }

  .post-body :global(ul) {
    margin: 0 0 1.4rem;
    padding-left: 1.3rem;
  }

  .post-body :global(li) {
    margin-bottom: 0.6rem;
    line-height: 1.65;
  }

  .post-body :global(li)::marker {
    color: var(--burnt-deep);
  }

  .post-body :global(strong) {
    color: var(--charcoal);
    font-weight: 600;
  }

  .post-body :global(p a),
  .post-body :global(li a) {
    color: var(--burnt-deep);
    text-decoration-color: currentColor;
    text-underline-offset: 2px;
  }

  .post-body :global(figure.post-photo) {
    margin: 2.5rem 0;
  }

  .post-body :global(figure.post-photo img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1.5px solid var(--charcoal);
  }

  .post-body :global(figure.post-photo figcaption) {
    margin-top: 0.65rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    text-align: center;
    color: var(--charcoal);
  }

  .post-body :global(figure.post-video-figure) {
    margin: 2.5rem 0;
  }

  .post-body :global(figure.post-video-figure figcaption) {
    margin-top: 0.65rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    text-align: center;
    color: var(--charcoal);
  }

  .post-body :global(.post-video) {
    position: relative;
    display: block;
  }

  .post-body :global(.post-video img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1.5px solid var(--charcoal);
  }

  .post-body :global(.post-video .play-badge) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--paper);
    border: 1.5px solid var(--charcoal);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--charcoal);
    font-size: 1.1rem;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  .post-body :global(.post-video:hover .play-badge) {
    transform: translate(-50%, -50%) scale(1.08);
    background: var(--sage);
  }
</style>
